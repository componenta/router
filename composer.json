{
    "name": "componenta/router",
    "description": "HTTP route registration, matching, generation, and compiled route cache for Componenta applications",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/arrayable": "^1.0",
        "componenta/config": "^4.0",
        "componenta/di": "^6.0",
        "componenta/http-responder": "^2.0",
        "componenta/middleware-factory": "^3.0",
        "componenta/path-resolver": "^1.0",
        "componenta/var-export": "^2.0.0",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Http\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Http\\Router\\Tests\\": "tests/",
            "Componenta\\Http\\Router\\Benchmarks\\": "benchmarks/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\Http\\Router\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-refactor/router-v4": "4.0.x-dev",
            "dev-refactor/unified-application-build-2026-11-27": "4.0.x-dev"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "nyholm/psr7": "^1.8",
        "phpbench/phpbench": "^1.7"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "benchmark": "@php vendor/bin/phpbench run --report=aggregate"
    }
}
